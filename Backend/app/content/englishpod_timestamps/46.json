{"text": "Bye.", "start": 911.48, "end": 911.4}, {"text": "Bye.", "start": 911.5, "end": 911.4}, {"text": "Bye.", "start": 911.5, "end": 911.28}, {"text": "Bye.", "start": 911.4, "end": 911.22}, {"text": "bye.", "start": 911.36, "end": 911.3199999999999}, {"text": "bye.", "start": 911.48, "end": 911.4}]